# ============================================
# AI 自动化测试框架 — 环境变量配置模板
# 复制此文件为 .env 并填入你的 API Key
# ============================================

# AI 模式：mock（模拟） / real（真实 AI）
AI_MODE=real

# DeepSeek API Key
# 获取地址：https://platform.deepseek.com
DEEPSEEK_API_KEY=sk-your-key-here

# 模型选择
AI_MODEL=deepseek-chat

# API 地址（默认 DeepSeek，兼容 OpenAI）
AI_BASE_URL=https://api.deepseek.com
